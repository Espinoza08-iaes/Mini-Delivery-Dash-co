﻿# --- Directorios de Build y CMake (Sistemas cruzados) ---
/build/
/build-*/
/bin/
/out/
/dist/
/CMakeFiles/
/CMakeCache.txt
/cmake_install.cmake
/Makefile
/compile_commands.json
/cmake-build/

# --- Ejecutables y Librerías (Binarios) ---
*.exe
*.out
*.app
*.so
*.dylib
*.a
*.lib
*.pdb
*.exp
*.dll
main

# --- Permitir librerías precompiladas en third_party/lib ---
!third_party/**/lib/*.dll
!third_party/**/lib/*.a
!third_party/**/lib/*.lib
!third_party/**/lib/*.dll.a

