﻿# --- Directorios de Build y CMake (Sistemas cruzados) ---
build/
build-*/
bin/
out/
dist/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
compile_commands.json

# --- Ejecutables y Librerías (Binarios) ---
*.exe
*.out
*.app
*.so
*.dylib
*.a
*.lib
*.pdb
*.exp
*.dll
main

# --- Permitir librerías precompiladas en third_party/lib (si quieres compartirlas) ---
# Coloca estas negaciones después de las reglas globales para que surtan efecto
!third_party/**/lib/*.dll
!third_party/**/lib/*.a
!third_party/**/lib/*.lib
!third_party/**/lib/*.dll.a

